// Cloudflare Workers config: serves the built app in dist/ as static files.
// Cloudflare runs `npm run build`, then `npx wrangler deploy` reads this file.
{
  "name": "doughcalc",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    // Single-page app: unknown paths fall back to index.html.
    "not_found_handling": "single-page-application"
  }
}
