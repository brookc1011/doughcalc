{
  "name": "doughcalc",
  "compatibility_date": "2025-09-01",
  // Reminder server. Only /api/* runs this code; every other path is a static file from dist/.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // One small slot per phone (push address + step times), with one alarm for the next step.
  "durable_objects": {
    "bindings": [{ "name": "REMINDERS", "class_name": "Reminders" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Reminders"] }]
  // Secret (set in the Cloudflare dashboard, never here): VAPID_PRIVATE_KEY
}
