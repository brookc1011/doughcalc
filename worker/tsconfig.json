{
  // Type-checks the reminder worker against Cloudflare's runtime types
  // (worker-configuration.d.ts, made by `npx wrangler types worker/worker-configuration.d.ts`).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": []
  },
  "include": ["*.ts"]
}
